import { useState, useRef } from 'react';
import { useNavigate, useSearchParams } from 'react-router-dom';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Label } from '@/components/ui/label';
import { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group';
import { ArrowLeft, Upload, CreditCard, Building2, Check, Loader2, Copy } from 'lucide-react';
import { useToast } from '@/hooks/use-toast';
import { paymentsApi } from '@/db/api';
import { PAYMENT_CONFIG } from '@/config/payment';
import type { PlanType, PaymentMethod } from '@/types/types';
import { cn } from '@/lib/utils';

export default function Payment() {
  const [searchParams] = useSearchParams();
  const planId = (searchParams.get('plan') || 'pro') as PlanType;
  const navigate = useNavigate();
  const { toast } = useToast();
  
  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod>('upi');
  const [screenshot, setScreenshot] = useState<File | null>(null);
  const [previewUrl, setPreviewUrl] = useState<string>('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [copiedField, setCopiedField] = useState<string>('');
  const fileInputRef = useRef<HTMLInputElement>(null);

  const planConfig = PAYMENT_CONFIG.plans[planId as 'pro' | 'business'];
  
  if (!planConfig) {
    navigate('/plans');
    return null;
  }

  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    // Validate file size (1MB)
    if (file.size > 1048576) {
      toast({
        title: 'File Too Large',
        description: 'Screenshot must be less than 1MB',
        variant: 'destructive',
      });
      return;
    }

    // Validate file type
    if (!['image/jpeg', 'image/png', 'image/jpg'].includes(file.type)) {
      toast({
        title: 'Invalid File Type',
        description: 'Only JPEG and PNG images are allowed',
        variant: 'destructive',
      });
      return;
    }

    setScreenshot(file);
    const reader = new FileReader();
    reader.onloadend = () => {
      setPreviewUrl(reader.result as string);
    };
    reader.readAsDataURL(file);
  };

  const handleCopy = (text: string, field: string) => {
    navigator.clipboard.writeText(text);
    setCopiedField(field);
    toast({
      title: '✅ Copied!',
      description: `${field} copied to clipboard`,
    });
    setTimeout(() => setCopiedField(''), 2000);
  };

  const handleSubmit = async () => {
    if (!screenshot) {
      toast({
        title: 'Screenshot Required',
        description: 'Please upload payment screenshot',
        variant: 'destructive',
      });
      return;
    }

    setIsSubmitting(true);

    try {
      const result = await paymentsApi.createPaymentRequest(
        planId,
        paymentMethod,
        screenshot,
        planConfig.price
      );

      if (result.success) {
        toast({
          title: '✅ Payment Request Submitted',
          description: 'Your payment is under review. You will be notified once approved.',
        });
        navigate('/plans');
      } else {
        toast({
          title: 'Submission Failed',
          description: result.error || 'Failed to submit payment request',
          variant: 'destructive',
        });
      }
    } catch (error) {
      toast({
        title: 'Error',
        description: 'An error occurred while submitting payment',
        variant: 'destructive',
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-background via-background to-primary/5">
      <div className="container mx-auto px-4 py-8 max-w-4xl">
        <Button
          variant="ghost"
          onClick={() => navigate('/plans')}
          className="mb-6 hover:bg-primary/10"
        >
          <ArrowLeft className="w-4 h-4 mr-2" />
          Back to Plans
        </Button>

        <div className="grid gap-6 xl:grid-cols-2">
          {/* Payment Details */}
          <Card className="border-2 border-border shadow-2xl">
            <CardHeader className="bg-gradient-to-br from-primary/10 to-accent/10">
              <CardTitle className="text-2xl gradient-text">Complete Payment</CardTitle>
              <CardDescription className="text-base">
                {planId.charAt(0).toUpperCase() + planId.slice(1)} Plan - {planConfig.currency}{planConfig.price}/{planConfig.duration}
              </CardDescription>
            </CardHeader>
            <CardContent className="pt-6 space-y-6">
              {/* Payment Method Selection */}
              <div className="space-y-3">
                <Label className="text-base font-semibold">Select Payment Method</Label>
                <RadioGroup value={paymentMethod} onValueChange={(value) => setPaymentMethod(value as PaymentMethod)}>
                  <div className="flex items-center space-x-3 p-4 rounded-xl border-2 border-border hover:border-primary/50 transition-all cursor-pointer">
                    <RadioGroupItem value="upi" id="upi" />
                    <Label htmlFor="upi" className="flex items-center gap-2 cursor-pointer flex-1">
                      <CreditCard className="w-5 h-5 text-primary" />
                      <span className="font-semibold">UPI Payment</span>
                    </Label>
                  </div>
                  <div className="flex items-center space-x-3 p-4 rounded-xl border-2 border-border hover:border-primary/50 transition-all cursor-pointer">
                    <RadioGroupItem value="netbanking" id="netbanking" />
                    <Label htmlFor="netbanking" className="flex items-center gap-2 cursor-pointer flex-1">
                      <Building2 className="w-5 h-5 text-primary" />
                      <span className="font-semibold">Net Banking</span>
                    </Label>
                  </div>
                </RadioGroup>
              </div>

              {/* Payment Instructions */}
              <div className="space-y-4 p-5 bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl border-2 border-primary/20">
                <h3 className="font-bold text-lg flex items-center gap-2">
                  <span className="w-8 h-8 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-sm">1</span>
                  Payment Details
                </h3>
                
                {paymentMethod === 'upi' ? (
                  <div className="space-y-3">
                    <div className="flex items-center justify-between p-3 bg-card rounded-xl border border-border">
                      <div>
                        <p className="text-sm text-muted-foreground">UPI ID</p>
                        <p className="font-mono font-bold text-lg">{PAYMENT_CONFIG.upi.id}</p>
                      </div>
                      <Button
                        size="sm"
                        variant="outline"
                        onClick={() => handleCopy(PAYMENT_CONFIG.upi.id, 'UPI ID')}
                        className="hover:bg-primary/10"
                      >
                        {copiedField === 'UPI ID' ? (
                          <Check className="w-4 h-4 text-green-500" />
                        ) : (
                          <Copy className="w-4 h-4" />
                        )}
                      </Button>
                    </div>
                    <div className="p-3 bg-card rounded-xl border border-border">
                      <p className="text-sm text-muted-foreground">Account Name</p>
                      <p className="font-semibold">{PAYMENT_CONFIG.upi.name}</p>
                    </div>
                    <div className="p-3 bg-card rounded-xl border border-border">
                      <p className="text-sm text-muted-foreground">Amount to Pay</p>
                      <p className="font-bold text-2xl text-primary">{planConfig.currency}{planConfig.price}</p>
                    </div>
                  </div>
                ) : (
                  <div className="space-y-3">
                    <div className="flex items-center justify-between p-3 bg-card rounded-xl border border-border">
                      <div>
                        <p className="text-sm text-muted-foreground">Account Number</p>
                        <p className="font-mono font-bold">{PAYMENT_CONFIG.netbanking.accountNumber}</p>
                      </div>
                      <Button
                        size="sm"
                        variant="outline"
                        onClick={() => handleCopy(PAYMENT_CONFIG.netbanking.accountNumber, 'Account Number')}
                        className="hover:bg-primary/10"
                      >
                        {copiedField === 'Account Number' ? (
                          <Check className="w-4 h-4 text-green-500" />
                        ) : (
                          <Copy className="w-4 h-4" />
                        )}
                      </Button>
                    </div>
                    <div className="flex items-center justify-between p-3 bg-card rounded-xl border border-border">
                      <div>
                        <p className="text-sm text-muted-foreground">IFSC Code</p>
                        <p className="font-mono font-bold">{PAYMENT_CONFIG.netbanking.ifscCode}</p>
                      </div>
                      <Button
                        size="sm"
                        variant="outline"
                        onClick={() => handleCopy(PAYMENT_CONFIG.netbanking.ifscCode, 'IFSC Code')}
                        className="hover:bg-primary/10"
                      >
                        {copiedField === 'IFSC Code' ? (
                          <Check className="w-4 h-4 text-green-500" />
                        ) : (
                          <Copy className="w-4 h-4" />
                        )}
                      </Button>
                    </div>
                    <div className="p-3 bg-card rounded-xl border border-border">
                      <p className="text-sm text-muted-foreground">Account Name</p>
                      <p className="font-semibold">{PAYMENT_CONFIG.netbanking.accountName}</p>
                    </div>
                    <div className="p-3 bg-card rounded-xl border border-border">
                      <p className="text-sm text-muted-foreground">Bank Name</p>
                      <p className="font-semibold">{PAYMENT_CONFIG.netbanking.bankName}</p>
                    </div>
                    <div className="p-3 bg-card rounded-xl border border-border">
                      <p className="text-sm text-muted-foreground">Amount to Pay</p>
                      <p className="font-bold text-2xl text-primary">{planConfig.currency}{planConfig.price}</p>
                    </div>
                  </div>
                )}
              </div>
            </CardContent>
          </Card>

          {/* Screenshot Upload */}
          <Card className="border-2 border-border shadow-2xl">
            <CardHeader className="bg-gradient-to-br from-accent/10 to-primary/10">
              <CardTitle className="text-2xl gradient-text">Upload Payment Proof</CardTitle>
              <CardDescription className="text-base">
                Upload screenshot of your payment
              </CardDescription>
            </CardHeader>
            <CardContent className="pt-6 space-y-6">
              <div className="space-y-4 p-5 bg-gradient-to-br from-accent/5 to-primary/5 rounded-2xl border-2 border-accent/20">
                <h3 className="font-bold text-lg flex items-center gap-2">
                  <span className="w-8 h-8 rounded-full bg-accent text-white flex items-center justify-center text-sm">2</span>
                  Upload Screenshot
                </h3>
                
                <input
                  ref={fileInputRef}
                  type="file"
                  accept="image/jpeg,image/png,image/jpg"
                  onChange={handleFileSelect}
                  className="hidden"
                />

                {!previewUrl ? (
                  <button
                    onClick={() => fileInputRef.current?.click()}
                    className={cn(
                      'w-full p-8 border-3 border-dashed rounded-2xl transition-all duration-300',
                      'hover:border-primary hover:bg-primary/5',
                      'flex flex-col items-center justify-center gap-4',
                      'border-border bg-card'
                    )}
                  >
                    <div className="w-16 h-16 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center">
                      <Upload className="w-8 h-8 text-white" />
                    </div>
                    <div className="text-center">
                      <p className="font-semibold text-lg">Click to upload</p>
                      <p className="text-sm text-muted-foreground mt-1">
                        JPEG or PNG (max 1MB)
                      </p>
                    </div>
                  </button>
                ) : (
                  <div className="space-y-4">
                    <div className="relative rounded-2xl overflow-hidden border-2 border-primary shadow-xl">
                      <img
                        src={previewUrl}
                        alt="Payment screenshot"
                        className="w-full h-auto"
                      />
                      <div className="absolute top-2 right-2">
                        <Button
                          size="sm"
                          variant="destructive"
                          onClick={() => {
                            setScreenshot(null);
                            setPreviewUrl('');
                          }}
                          className="shadow-lg"
                        >
                          Remove
                        </Button>
                      </div>
                    </div>
                    <div className="flex items-center gap-2 p-3 bg-green-500/10 border-2 border-green-500/30 rounded-xl">
                      <Check className="w-5 h-5 text-green-500" />
                      <span className="text-sm font-semibold text-green-600 dark:text-green-400">
                        Screenshot uploaded successfully
                      </span>
                    </div>
                  </div>
                )}
              </div>

              <div className="space-y-4 p-5 bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl border-2 border-primary/20">
                <h3 className="font-bold text-lg flex items-center gap-2">
                  <span className="w-8 h-8 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-sm">3</span>
                  Submit Request
                </h3>
                <p className="text-sm text-muted-foreground">
                  After submitting, our team will verify your payment within 24 hours. You'll receive a notification once approved.
                </p>
                <Button
                  onClick={handleSubmit}
                  disabled={!screenshot || isSubmitting}
                  className="w-full h-12 text-lg font-bold bg-gradient-to-r from-primary to-accent hover:shadow-2xl hover:shadow-primary/30 transition-all duration-300 hover:scale-105"
                >
                  {isSubmitting ? (
                    <>
                      <Loader2 className="w-5 h-5 mr-2 animate-spin" />
                      Submitting...
                    </>
                  ) : (
                    <>
                      <Check className="w-5 h-5 mr-2" />
                      Submit Payment Request
                    </>
                  )}
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
}
